{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git init)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git push)",
      "Bash(git push -u origin main)",
      "Bash(git push origin main)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(pip install:*)",
      "Bash(.venv/Scripts/python:*)",
      "Bash(.venv/Scripts/pip:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  }
}